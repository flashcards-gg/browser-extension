    "The extension is off in Safari.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإضافة غير مفعّلة في Safari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozšíření je v Safari vypnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udvidelsen er slået fra i Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erweiterung ist in Safari deaktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επέκταση είναι ανενεργή στο Safari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión está desactivada en Safari."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laajennus on pois päältä Safarissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extension est désactivée dans Safari."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוסף כבוי ב-Safari."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सटेंशन Safari में बंद है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proširenje je isključeno u Safariju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény ki van kapcsolva a Safariban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstensi nonaktif di Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estensione è disattivata in Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能はSafariでオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 확장 프로그램이 꺼져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De extensie staat uit in Safari."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvidelsen er slått av i Safari."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozszerzenie jest wyłączone w Safari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão está desativada no Safari."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão está desativada no Safari."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensia este dezactivată în Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение выключено в Safari."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillägget är avslaget i Safari."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนขยายปิดอยู่ใน Safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzantı Safari’de kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розширення вимкнене в Safari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích mở rộng đang tắt trong Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展已在 Safari 中关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extension is off in Safari."
          }

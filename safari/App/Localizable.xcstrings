    "Click the Flashcards.gg button in the Safari toolbar and paste your API key from flashcards.gg (Account › API keys).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر زر Flashcards.gg في شريط أدوات Safari والصق مفتاح API من flashcards.gg (الحساب › مفاتيح API)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na tlačítko Flashcards.gg na panelu nástrojů Safari a vložte svůj API klíč z flashcards.gg (Účet › API klíče)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på Flashcards.gg-knappen på Safaris værktøjslinje, og indsæt din API-nøgle fra flashcards.gg (Konto › API-nøgler)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Safari-Symbolleiste auf die Taste „Flashcards.gg“ und füge deinen API-Schlüssel von flashcards.gg (Konto › API-Schlüssel) ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο κουμπί Flashcards.gg στη γραμμή εργαλείων του Safari και επικολλήστε το κλειδί API από το flashcards.gg (Λογαριασμός › Κλειδιά API)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón de Flashcards.gg de la barra de herramientas de Safari y pega tu clave de API de flashcards.gg (Cuenta › Claves de API)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa Flashcards.gg-painiketta Safarin työkalupalkissa ja liitä API-avaimesi flashcards.gg:stä (Tili › API-avaimet)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton Flashcards.gg dans la barre d’outils de Safari et collez votre clé API de flashcards.gg (Compte › Clés API)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על הכפתור Flashcards.gg בסרגל הכלים של Safari והדביקו את מפתח ה-API מ-flashcards.gg (חשבון › מפתחות API)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari टूलबार में Flashcards.gg बटन पर क्लिक करें और flashcards.gg (खाता › API कुंजियाँ) से अपनी API कुंजी चिपकाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite tipku Flashcards.gg na alatnoj traci Safarija i zalijepite svoj API ključ s flashcards.gg (Račun › API ključevi)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints a Flashcards.gg gombra a Safari eszközsorában, és illeszd be az API-kulcsodat a flashcards.gg-ről (Fiók › API-kulcsok)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik tombol Flashcards.gg di bar alat Safari, lalu tempel kunci API Anda dari flashcards.gg (Akun › Kunci API)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante Flashcards.gg nella barra degli strumenti di Safari e incolla la tua chiave API di flashcards.gg (Account › Chiavi API)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SafariのツールバーにあるFlashcards.ggボタンをクリックし、flashcards.gg（アカウント › APIキー）のAPIキーを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 도구 막대의 Flashcards.gg 버튼을 클릭하고 flashcards.gg(계정 › API 키)의 API 키를 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de Flashcards.gg-knop in de Safari-knoppenbalk en plak je API-sleutel van flashcards.gg (Account › API-sleutels)."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på Flashcards.gg-knappen i verktøylinjen i Safari, og lim inn API-nøkkelen din fra flashcards.gg (Konto › API-nøkler)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij przycisk Flashcards.gg na pasku narzędzi Safari i wklej swój klucz API z flashcards.gg (Konto › Klucze API)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão Flashcards.gg na barra de ferramentas do Safari e cole sua chave de API do flashcards.gg (Conta › Chaves de API)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão Flashcards.gg na barra de ferramentas do Safari e cole a sua chave de API do flashcards.gg (Conta › Chaves de API)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă clic pe butonul Flashcards.gg din bara de instrumente Safari și lipește cheia API de pe flashcards.gg (Cont › Chei API)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку Flashcards.gg на панели инструментов Safari и вставьте API-ключ с flashcards.gg (Аккаунт › API-ключи)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på Flashcards.gg-knappen i Safaris verktygsfält och klistra in din API-nyckel från flashcards.gg (Konto › API-nycklar)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่ม Flashcards.gg ในแถบเครื่องมือของ Safari แล้ววางคีย์ API จาก flashcards.gg (บัญชี › คีย์ API)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari araç çubuğundaki Flashcards.gg düğmesine tıklayın ve flashcards.gg’deki (Hesap › API anahtarları) API anahtarınızı yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку Flashcards.gg на панелі інструментів Safari і вставте API-ключ із flashcards.gg (Акаунт › API-ключі)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm nút Flashcards.gg trên thanh công cụ Safari và dán khóa API từ flashcards.gg (Tài khoản › Khóa API)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 Safari 工具栏中的 Flashcards.gg 按钮，粘贴来自 flashcards.gg（账户 › API 密钥）的 API 密钥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the Flashcards.gg button in the Safari toolbar and paste your API key from flashcards.gg (Account › API keys)."
          }
        }
      }
    },

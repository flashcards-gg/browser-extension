    "Add a card from selected text to your Flashcards.gg sets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف بطاقات من النص المحدد إلى مجموعاتك في Flashcards.gg."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávejte kartičky z vybraného textu do svých sad na Flashcards.gg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Føj kort fra markeret tekst til dine Flashcards.gg-sæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten aus markiertem Text in deine Flashcards.gg-Sets aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε κάρτες από επιλεγμένο κείμενο στα σετ σας στο Flashcards.gg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tarjetas a tus conjuntos de Flashcards.gg a partir del texto seleccionado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kortteja valitusta tekstistä Flashcards.gg-setteihisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une carte à vos ensembles Flashcards.gg à partir du texte sélectionné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו כרטיסיות מטקסט מסומן לסטים שלכם ב-Flashcards.gg."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए टेक्स्ट से अपने Flashcards.gg सेट में कार्ड जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kartice iz označenog teksta u svoje Flashcards.gg setove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kártyák hozzáadása kijelölt szövegből a Flashcards.gg-csomagjaidhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kartu dari teks yang dipilih ke set Flashcards.gg Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi carte ai tuoi set di Flashcards.gg dal testo selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストからFlashcards.ggのセットにカードを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트로 Flashcards.gg 세트에 카드를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg kaarten van geselecteerde tekst toe aan je Flashcards.gg-sets."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til kort fra merket tekst i settene dine på Flashcards.gg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj karty z zaznaczonego tekstu do swoich zestawów Flashcards.gg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cartões aos seus conjuntos do Flashcards.gg a partir do texto selecionado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione cartões aos seus conjuntos do Flashcards.gg a partir do texto selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă carduri din textul selectat în seturile tale Flashcards.gg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте карточки из выделенного текста в свои наборы Flashcards.gg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till kort från markerad text i dina uppsättningar på Flashcards.gg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มการ์ดจากข้อความที่เลือกลงในชุดของคุณบน Flashcards.gg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili metinden Flashcards.gg setlerinize kart ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте картки з виділеного тексту у свої набори Flashcards.gg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thẻ từ văn bản đã chọn vào các bộ Flashcards.gg của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从选中的文字向你的 Flashcards.gg 卡片集添加卡片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a card from selected text to your Flashcards.gg sets."
          }
        }
      }
    },

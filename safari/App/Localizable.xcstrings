    "Select text on a page, Control-click it and choose “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد نصًا في صفحة، ثم انقر عليه مع الضغط على Control واختر «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte text na stránce, klikněte na něj se stisknutou klávesou Control a vyberte „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker tekst på en side, ctrl-klik på den, og vælg »%@«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Text auf einer Seite, klicke ihn mit gedrückter ctrl-Taste an und wähle „%@“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε κείμενο σε μια σελίδα, κάντε Control-κλικ πάνω του και επιλέξτε «%@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona texto en una página, haz clic en él con la tecla Control pulsada y elige «%@»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tekstiä sivulta, ctrl-osoita sitä ja valitse ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez du texte sur une page, cliquez dessus en maintenant la touche Contrôle enfoncée et choisissez « %@ »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמנו טקסט בדף, לחצו עליו עם Control ובחרו ב“%@”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज पर टेक्स्ट चुनें, Control दबाकर उस पर क्लिक करें और “%@” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite tekst na stranici, kliknite ga uz pritisnutu tipku Control i odaberite „%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölj ki szöveget egy oldalon, kattints rá a Control billentyűt lenyomva tartva, és válaszd a(z) „%@” lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih teks di halaman, klik teks itu sambil menekan Control, lalu pilih “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona del testo in una pagina, fai clic sul testo tenendo premuto Ctrl e scegli “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上のテキストを選択し、Controlキーを押しながらクリックして「%@」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에서 텍스트를 선택하고 Control 키를 누른 채 클릭한 다음 ‘%@’을(를) 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer tekst op een pagina, klik er met de Control-toets ingedrukt op en kies ‘%@’."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk tekst på en side, kontrollklikk på den og velg «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz tekst na stronie, kliknij go z klawiszem Control i wybierz „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um texto na página, clique nele com a tecla Control pressionada e escolha “%@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione texto numa página, clique nele com a tecla Control premida e escolha “%@”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectează text pe o pagină, fă Control-clic pe el și alege „%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите текст на странице, нажмите на него с клавишей Control и выберите «%@»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera text på en sida, kontrollklicka på den och välj ”%@”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกข้อความบนหน้าเว็บ กด Control ค้างไว้แล้วคลิกที่ข้อความ จากนั้นเลือก “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfada bir metin seçin, Control tuşuna basılı tutarak tıklayın ve “%@” seçeneğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділіть текст на сторінці, натисніть на нього з клавішею Control і виберіть «%@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn văn bản trên trang, Control-bấm vào đó và chọn “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网页上选中文字，按住 Control 键点按，然后选择“%@”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text on a page, Control-click it and choose “%@”."
          }
        }
      }
    },
